# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Project Configuration
PROJECT_NAME=fiza_cosmic_animator
OUTPUT_PATH=./assets/output
TEMP_PATH=./assets/temp

# CUDA Configuration
CUDA_DEVICE=0
USE_CUDA=true

# Animation Settings
FPS=30
DURATION_SECONDS=5
MOTION_INTENSITY=0.7

# Video Export Settings
VIDEO_QUALITY=high
CODEC=h264
BITRATE=8000k

# n8n Webhook Configuration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/animate
N8N_API_KEY=your_n8n_api_key_here
